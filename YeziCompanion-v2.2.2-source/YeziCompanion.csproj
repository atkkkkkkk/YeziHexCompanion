<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>YeziCompanion</AssemblyName>
    <RootNamespace>YeziCompanion</RootNamespace>
    <Version>2.2.2</Version>
    <AssemblyVersion>2.2.2.0</AssemblyVersion>
    <FileVersion>2.2.2.0</FileVersion>
    <Product>椰子海斗助手 · YeziCompanion</Product>
    <ApplicationIcon>Assets/App.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <Content Include="README.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="SkiaSharp-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="SkiaSharp-THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Tests/champions.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Tests/portraits/*.webp" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
