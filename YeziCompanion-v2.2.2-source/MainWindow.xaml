<Window x:Class="YeziCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="椰子海斗助手 · 2.2.2" Width="1180" Height="820" MinWidth="940" MinHeight="680"
        Foreground="{StaticResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="{StaticResource PageBackground}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown" ContentRendered="MainWindow_ContentRendered">
    <Window.Icon>
        <DrawingImage>
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#17171C">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,32,32" RadiusX="7" RadiusY="7" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#8FD8BF" Geometry="F0 M16,3 L29,16 L16,29 L3,16 Z M16,11 L11,16 L16,21 L21,16 Z" />
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Icon>

    <Grid x:Name="RootSurface" Background="{StaticResource PageBackground}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="100" /></Grid.RowDefinitions>
        <Grid x:Name="MainContent">
            <Grid.RenderTransform><TranslateTransform x:Name="MainContentTransform" /></Grid.RenderTransform>
            <Grid.ColumnDefinitions><ColumnDefinition Width="176" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <!-- Persistent navigation, inspired by a desktop music library. -->
            <Border Background="#09090B" BorderBrush="#232329" BorderThickness="0,0,1,0" Padding="16,26,16,16">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,22">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="25" Height="25" Margin="0,0,9,0">
                                <Path Data="M12,0 L24,12 L12,24 L0,12 Z M12,7 L7,12 L12,17 L17,12 Z"
                                      Fill="{StaticResource AccentBrush}" />
                            </Viewbox>
                            <TextBlock Text="椰子海斗助手" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="YEZI  /  2.2.2" Foreground="{StaticResource SubtleBrush}" FontSize="9" Margin="34,7,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="ConnectionCenter" DockPanel.Dock="Bottom">
                        <TextBlock Text="连接中心" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,10" />
                        <TextBlock x:Name="ConnectionHintText" Text="正在检查本机客户端与对局。"
                                   MaxHeight="54" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   FontSize="11" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" LineHeight="18" />
                        <Button Content="重新连接" Click="Reconnect_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,6" MinHeight="32" Height="32" Padding="8,4" />
                        <Button Content="指定游戏目录" Click="ChooseClientDirectory_Click"
                                Style="{StaticResource SecondaryButtonStyle}" FontSize="11" MinHeight="32" Height="32" Padding="8,4" />
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,12" />
                        <TextBlock Text="自动化" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,14" />
                        <CheckBox x:Name="AutoAcceptCheckBox" Content="接受对局" IsChecked="True"
                                  Style="{StaticResource SwitchCheckBoxStyle}" Margin="0,0,0,14"
                                  Checked="AutoAcceptCheckBox_Changed" Unchecked="AutoAcceptCheckBox_Changed" />
                        <CheckBox x:Name="AutoOpenWebsiteCheckBox" Content="打开英雄数据" IsChecked="True"
                                  Style="{StaticResource SwitchCheckBoxStyle}"
                                  Checked="AutoOpenWebsiteCheckBox_Changed" Unchecked="AutoOpenWebsiteCheckBox_Changed" />
                    </StackPanel>
                    <StackPanel x:Name="HeroNavigation">
                        <TextBlock Text="英雄资料库" Style="{StaticResource EyebrowTextStyle}" Margin="10,0,0,12" />
                        <RadioButton x:Name="AllHeroesRadio" GroupName="HeroScope" Content="全部英雄"
                                     Style="{StaticResource NavigationItemStyle}" Checked="Filter_Changed" Margin="0,0,0,6" />
                        <RadioButton x:Name="AvailableHeroesRadio" GroupName="HeroScope" Content="共享席空闲"
                                     Style="{StaticResource NavigationItemStyle}" Checked="Filter_Changed" Margin="0,0,0,6" />
                        <RadioButton x:Name="TeammateHeroesRadio" GroupName="HeroScope" Content="队友持有"
                                     Style="{StaticResource NavigationItemStyle}" Checked="Filter_Changed" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="24,24,24,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="YOUR CHAMPION LIBRARY" FontSize="10" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,7" />
                        <TextBlock Text="海克斯大乱斗" FontSize="28" FontWeight="Bold" />
                        <TextBlock Text="英雄强度 · 共享席 · 实时候选" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                    <Border x:Name="ConnectionBadge" Grid.Column="1" Background="{StaticResource PendingBadgeBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18"
                            Padding="12,8" VerticalAlignment="Top" Margin="12,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnectionDot" Width="6" Height="6" Fill="{StaticResource DangerBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="ConnectionText" Text="正在连接" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="ArmedCard" Grid.Row="1" CornerRadius="18" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" Padding="18,17" Margin="0,0,0,22">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#243A37" Offset="0" /><GradientStop Color="#202327" Offset=".55" />
                            <GradientStop Color="#19191E" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform><ScaleTransform x:Name="ArmedCardScale" /></Border.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="候选目标" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,7" />
                            <TextBlock x:Name="ArmedTitle" Text="选择你的下一位英雄" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ArmedSubtitle" Text="点击英雄设为候选，进入共享席时自动尝试交换。"
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <CheckBox x:Name="AutoGrabCheckBox" Content="自动抢选" IsChecked="True" Style="{StaticResource SwitchCheckBoxStyle}"
                                      Checked="AutoGrabCheckBox_Changed" Unchecked="AutoGrabCheckBox_Changed" Margin="0,0,0,12" />
                            <Button x:Name="CancelCandidateButton" Content="取消候选" IsEnabled="False" Click="CancelArmed_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" MinHeight="30" Height="30" Padding="12,4" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Height="38" Tag="搜索英雄、称号、梯队    Ctrl+F"
                             TextChanged="SearchBox_TextChanged" ToolTip="Ctrl+F 搜索 · Esc 清空" />
                    <Button Grid.Column="1" Content="清空" Click="ClearSearch_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Height="38" />
                    <Button Grid.Column="2" x:Name="RefreshButton" Content="刷新数据" Click="RefreshData_Click"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Height="38" />
                </Grid>
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="1" BorderThickness="0" CornerRadius="14">
                <Grid>
                    <DataGrid x:Name="ChampionGrid" ItemsSource="{Binding RowsView}" AutoGenerateColumns="False"
                              SizeChanged="ChampionGrid_SizeChanged" CanUserResizeColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="Transparent" Foreground="{StaticResource TextBrush}"
                              BorderThickness="0" RowHeaderWidth="0" SelectionMode="Single"
                              HorizontalGridLinesBrush="{StaticResource BorderBrush}" ColumnHeaderHeight="42" RowHeight="58"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.IsDeferredScrollingEnabled="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource PanelRaised}" />
                                <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="12,6" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="2,0,0,0" />
                                <Setter Property="SnapsToDevicePixels" Value="True" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PanelHover}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsTeammateHeld}" Value="True">
                                        <Setter Property="Background" Value="#19191E" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                        <Setter Property="Background" Value="#182725" />
                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsArmed}" Value="True">
                                        <Setter Property="Background" Value="#1D302D" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PanelSelected}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="ScrollBar">
                                <Setter Property="Width" Value="10" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Grid Background="Transparent" Margin="2">
                                                <Track x:Name="PART_Track" IsDirectionReversed="True"
                                                       Orientation="{TemplateBinding Orientation}">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False" />
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb MinHeight="34">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border Background="{StaticResource BorderStrongBrush}" CornerRadius="4" />
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False" />
                                                    </Track.IncreaseRepeatButton>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="排名" Binding="{Binding RankDisplay}"
                                                Width="52" SortMemberPath="Rank" />
                            <DataGridTemplateColumn Header="英雄" Width="2*" MinWidth="160" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="40" Height="40" CornerRadius="9" ClipToBounds="True"
                                                    Margin="0,0,12,0" BorderBrush="{StaticResource BorderStrongBrush}"
                                                    BorderThickness="1">
                                                <Grid Background="{StaticResource PanelRaised}">
                                <TextBlock Text="{Binding Initial}" Foreground="{StaticResource MutedBrush}" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding Portrait}" Stretch="UniformToFill" />
                            </Grid>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource MutedBrush}"
                                                           FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="梯队" Width="52" SortMemberPath="Tier">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource PanelRaised}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tier}" Value="S+">
                                                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tier}" Value="S">
                                                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Tier}" FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tier}" Value="S+">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tier}" Value="S">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="胜率" Binding="{Binding WinRateDisplay}"
                                                Width="70" SortMemberPath="WinRate" />
                            <DataGridTextColumn Header="选取率" Binding="{Binding PickRateDisplay}"
                                                Width="70" SortMemberPath="PickRate" />
                            <DataGridTemplateColumn Header="状态" Width="98">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="7" Padding="8,4" HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Opacity" Value="0.6" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTeammateHeld}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                            <Setter Property="Background" Value="#302D22" />
                                                            <Setter Property="BorderBrush" Value="#52492C" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="5" Height="5" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource SubtleBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTeammateHeld}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource GoldBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding AvailabilityText}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTeammateHeld}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="122">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding ActionText}" Click="ArmChampion_Click"
                                                Style="{StaticResource CompactActionButtonStyle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="详情" Width="56">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <Hyperlink NavigateUri="{Binding DetailsUrl}"
                                                       RequestNavigate="ChampionLink_RequestNavigate">查看</Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="EmptyStatePanel" Background="{StaticResource PanelBackground}" CornerRadius="11"
                            Visibility="Collapsed" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                            <Border Width="46" Height="46" CornerRadius="13"
                                    Background="{StaticResource AccentFaintBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Margin="0,0,0,12">
                                <Viewbox Width="22" Height="22">
                                    <Path Data="M10.5,3 C6.36,3 3,6.36 3,10.5 C3,14.64 6.36,18 10.5,18 C12.3,18 13.95,17.37 15.24,16.31 L20.5,21.5 M15.24,16.31 C16.93,14.93 18,12.84 18,10.5 C18,6.36 14.64,3 10.5,3 Z"
                                          Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Fill="Transparent" />
                                </Viewbox>
                            </Border>
                            <TextBlock Text="当前没有可显示的英雄" FontSize="17"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyStateText"
                                       Text="进入海克斯大乱斗选人阶段后，这里会显示共享席英雄。"
                                       Foreground="{StaticResource MutedBrush}" FontSize="12"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>


                <Grid Grid.Row="4" Margin="2,10,2,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,12,0">
                        <TextBlock x:Name="DataHealthText" Text="加载中" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                        <TextBlock x:Name="ActivityText" Text="正在初始化…" FontSize="10" Foreground="{StaticResource SubtleBrush}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </DockPanel>
                    <TextBlock x:Name="DatasetText" Grid.Column="1" Text="ARAMKit" FontSize="10" Foreground="{StaticResource SubtleBrush}" />
                </Grid>
            </Grid>
        </Grid>

        <!-- A persistent current-hero dock, analogous to a now-playing bar. -->
        <Border x:Name="CurrentChampionCard" Grid.Row="1" Background="#18181D" BorderBrush="#303037"
                BorderThickness="0,1,0,0" Padding="24,16">
            <Grid>
                <StackPanel x:Name="CurrentChampionPlaceholder" Orientation="Horizontal">
                    <Border Width="56" Height="56" Background="#24242A" CornerRadius="12" Margin="0,0,16,0">
                        <Path Data="M12,1 L23,12 L12,23 L1,12 Z M12,7 L7,12 L12,17 L17,12 Z"
                              Fill="#63636F" Width="26" Height="26" Stretch="Uniform" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="当前英雄" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="选人阶段或游戏中连接后，自动同步你的英雄。" FontSize="11" Foreground="{StaticResource SubtleBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
                <Grid x:Name="CurrentChampionContent" Visibility="Collapsed">
                    <Grid.RenderTransform><TranslateTransform x:Name="CurrentChampionTransform" /></Grid.RenderTransform>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="12" Margin="0,0,16,0" Background="{StaticResource PanelRaised}">
                        <Grid>
                            <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" />
                            <Image Source="{Binding Portrait}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="当前英雄" FontSize="10" Foreground="{StaticResource SubtleBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding Title}" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="2" CornerRadius="20" Background="#E6E7EB" Padding="20,10" VerticalAlignment="Center">
                        <TextBlock>
                            <Hyperlink Foreground="#17171C" NavigateUri="{Binding DetailsUrl}" RequestNavigate="ChampionLink_RequestNavigate"
                                       FontWeight="SemiBold">查看英雄数据</Hyperlink>
                        </TextBlock>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
